# Salin file ini jadi `.env`, lalu isi dengan URL asli.
# File `.env` TIDAK boleh di-commit (sudah masuk .gitignore).

# Port server
PORT=8080

# Apps Script Web App (doPost) — tujuan upload transaksi
APPS_SCRIPT_SUBMIT_URL=https://script.google.com/macros/s/XXXX/exec

# Apps Script data endpoint — sumber data report.html
APPS_SCRIPT_REPORT_URL=https://script.googleusercontent.com/macros/echo?user_content_key=XXXX&lib=XXXX

# Kunci tanda tangan session cookie (min 32 karakter).
# Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ganti-dengan-hasil-random-32-byte

# Superadmin otomatis keluar setelah sekian menit tidak aktif.
# Kasir tetap masuk sampai menekan Keluar.
ADMIN_SESSION_MINUTES=15

# Set true kalau sudah dilayani lewat HTTPS
SECURE_COOKIE=false

# Set true HANYA kalau di belakang reverse proxy (Nginx/Caddy)
# yang mengisi X-Forwarded-For. Dipakai rate limit login.
TRUST_PROXY=false

# Folder data runtime (akun & menu). Default: ./data
# DATA_DIR=/var/lib/broodle

# Folder foto produk. Default: ./uploads
# UPLOADS_DIR=/var/lib/broodle/uploads

# Uji lokal saja: false = form "Buka kasir" (uang modal) tidak muncul,
# setoran langsung dimulai dengan modal Rp300.000. Jangan dipakai di produksi.
# SETORAN_ASK_MODAL=false
